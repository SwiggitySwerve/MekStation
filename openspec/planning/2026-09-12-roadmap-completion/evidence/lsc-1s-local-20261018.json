  "security": {
    "operatorVerification": "Reads active stored identity, verifies through real password decryption, discards mutable plaintext buffer; never calls setActive or saves a vault row.",
    "keyLifetime": "Generated private-key bytes remain within the provision request and are zeroed in finally on success and encryption failure. No decrypted/generated key is stored in service fields. No guaranteed erasure of immutable JS password strings is claimed.",
    "errors": "Stable error code plus numeric retry/current-generation detail only; dependency errors are replaced without a cause or message copy. Public list failures are also generic. No logger or console calls in either new product module.",
    "operationRecords": "Fingerprint hashes kind/seat/expected generation/label, excluding both passwords and key bytes. Free-text labels and operation ids are caller input; the schema cannot prove arbitrary strings are not secrets."
  },
  "carryIn": {
    "CF-LSC1DB-1": "Numeric SQL bindings; provision and revoke use SQL generation predicates and require exactly one changed row; stale/no-op writes leave row and operation history untouched; revoke keeps lock, re-provision clears it.",
    "CF-LSC1DB-2": "Immediate SQLite transaction plus unique seat/result-generation index; two-connection loser and concurrent async operator writes record one winner. Operation insert failure rolls back credential write.",
    "CF-LSC1DB-3": "Revocation uses non-null semantics. Deadlines use the caller/service wall clock; rollback preserves future lock deadlines and MAX prevents recordFailure shortening them. Forward clock jumps may shorten time remaining.",
    "CF-LSC1DB-4": "No secret-bearing logs/errors/operation rows. Operator and generated key buffers are request-local; mint-specific lifetime/redaction remains LSC-1.",
    "CF-LSC1DB-5": "Only successful authentication/re-provision clears the durable count; next post-expiry failure re-locks. Every operator call consumes the fixed route-wide window before password KDF, including duplicate/denied/stale/error requests. Mint-specific locked/concurrent refusal consumption remains LSC-1.",
    "CF-LSC0-8": "Revoke preserves failure count/lock; re-provision resets both; generation-fenced clear/failure protects replacement credentials.",
    "CF-LSC0-15": "Policy binds 10 mint attempts, 5 operator attempts per 60 seconds, 5 failures -> 60-second lock, 1-hour token default/cap. Mint behavior remains LSC-1.",
    "CF-LSC0-16": "First-attempt anchored, process-local route window resets at 60 seconds, not keyed by address; durable lock/counter survive restart.",
    "CF-LSC0-17": "Replay still authenticates and consumes operator window; changed seat password does not overwrite the originally applied key."
  },
