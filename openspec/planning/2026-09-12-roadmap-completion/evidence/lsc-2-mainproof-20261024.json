    {
      "id": "CF-LSC2-L1-DUP",
      "severity": "Low",
      "owner": "Root registration follow-up",
      "target": "src/pages-modules/multiplayer/multiplayerPage.helpers.ts (mintToken with its lobby/spectate callers) and the local mintToken in src/pages/multiplayer/index.tsx; no registered unit owns them",
