@@ -0,0 +1,8 @@
+/** Match metadata patch semantics shared by both server stores. */
+import type { IMatchMeta, IMatchMetaPatch } from './IMatchStore';
+
+export function patchMatchMeta(before: IMatchMeta, patch: IMatchMetaPatch): IMatchMeta {
+  const { roomCode: patchRoomCode, ...restPatch } = patch;
+  const roomCode = patchRoomCode === null ? undefined : (patchRoomCode ?? before.roomCode);
+  return { ...before, ...restPatch, roomCode, updatedAt: new Date().toISOString() };
+}
