{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://megamek-web.app/schemas/unit.json",
  "title": "BattleTech Unit",
  "description": "Schema for serialized BattleTech unit definitions (BattleMechs, vehicles, etc.)",
  "type": "object",
  "required": ["id", "unitType"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])",
      "default": "1.0.0",
      "description": "Portable unit document version: strict MAJOR.MINOR.PATCH, supported major 1. Missing means 1.0.0; minor additions must be optional."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S+$",
      "description": "Unique identifier for the unit. The converter preserves source punctuation and Unicode, so IDs must be non-empty and whitespace-free."
    },
    "chassis": {
      "type": "string",
      "minLength": 1,
      "description": "Chassis name (e.g., 'Atlas')"
    },
    "model": {
      "type": "string",
      "description": "Model designation (e.g., 'AS7-D')"
    },
    "variant": {
      "type": "string",
      "description": "Optional variant name"
    },
    "unitType": {
      "type": "string",
      "enum": [
        "BattleMech",
        "OmniMech",
        "IndustrialMech",
        "ProtoMech",
        "Vehicle",
        "VTOL",
        "Aerospace",
        "Conventional Fighter",
        "Small Craft",
        "DropShip",
        "JumpShip",
        "WarShip",
        "Space Station",
        "Infantry",
        "Battle Armor",
        "BattleArmor",
        "Support Vehicle",
        "SupportVehicle",
        "ConventionalFighter",
        "SmallCraft",
        "BATTLEARMOR"
      ],
      "description": "Type of unit"
    },
    "configuration": {
      "type": "string",
      "enum": ["Biped", "Quad", "Tripod", "LAM", "QuadVee"],
      "description": "Mech configuration"
    },
    "techBase": {
      "type": "string",
      "enum": ["INNER_SPHERE", "CLAN", "MIXED"],
      "description": "Technology base"
    },
    "rulesLevel": {
      "type": "string",
      "enum": [
        "INTRODUCTORY",
        "STANDARD",
        "ADVANCED",
        "EXPERIMENTAL",
        "UNOFFICIAL"
      ],
      "description": "Rules level/complexity"
    },
    "era": {
      "type": "string",
      "description": "BattleTech era identifier"
    },
    "year": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 9999,
      "description": "Introduction year"
    },
    "tonnage": {
      "type": "number",
      "minimum": 0,
      "description": "Unit tonnage; the anyOf rule retains a 250 t bound, with explicit Support Vehicle (600 t) and capital ship (2,500,000 t) exceptions."
    },
    "engine": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "FUSION",
            "XL",
            "CLAN_XL",
            "LIGHT",
            "COMPACT",
            "XXL",
            "ICE",
            "FUEL_CELL",
            "FISSION",
            "FLYWHEEL",
            "BATTERY",
            "NONE",
            "STEAM"
          ],
          "description": "Engine type"
        },
        "rating": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Effective engine rating; support vehicles retain fractional tonnage times cruise MP"
        }
      },
      "additionalProperties": false
    },
    "gyro": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "STANDARD",
            "XL",
            "COMPACT",
            "HEAVY_DUTY",
            "SUPERHEAVY",
            "NONE"
          ],
          "description": "Gyro type"
        }
      },
      "additionalProperties": false
    },
    "cockpit": {
      "type": "string",
      "enum": [
        "STANDARD",
        "SMALL",
        "COMMAND_CONSOLE",
        "TORSO_MOUNTED",
        "PRIMITIVE",
        "INDUSTRIAL",
        "SUPERHEAVY",
        "SUPERHEAVY_TRIPOD",
        "INTERFACE",
        "VRRP",
        "QUADVEE",
        "PRIMITIVE_INDUSTRIAL",
        "DUAL",
        "TRIPOD",
        "SUPERHEAVY_INDUSTRIAL",
        "SUPERHEAVY_COMMAND_CONSOLE",
        "SMALL_COMMAND_CONSOLE",
        "TRIPOD_INDUSTRIAL",
        "SUPERHEAVY_TRIPOD_INDUSTRIAL"
      ],
      "description": "Cockpit type"
    },
    "structure": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "$ref": "#/$defs/structureType"
        },
        "locationTonnage": {
          "type": "object",
          "description": "FrankenMek only: structure tonnage per location (MegaMek MtfFile.java:669-691)",
          "propertyNames": {
            "$ref": "#/$defs/structureLocation"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "typeByLocation": {
          "type": "object",
          "description": "Explicit FrankenMek donor types; missing entries use native defaults. An absent map preserves legacy global structure behavior.",
          "propertyNames": {
            "$ref": "#/$defs/structureLocation"
          },
          "additionalProperties": {
            "$ref": "#/$defs/structureType"
          }
        }
      },
      "additionalProperties": false
    },
    "armor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "anyOf": [
            { "$ref": "#/$defs/standardArmorType" },
            {
              "type": "string",
              "enum": [
                "FERRO_CARBIDE",
                "LAMELLOR_FERRO_CARBIDE",
                "IMPROVED_FERRO_ALUMINUM"
              ]
            }
          ],
          "description": "Armor type"
        },
        "sourceTechLevel": { "type": "integer", "minimum": -1 },
        "barRating": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10,
          "description": "Support vehicle BAR rating when armor type is BAR"
        },
        "allocation": {
          "type": "object",
          "description": "Armor points per location",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "object",
                "required": ["front", "rear"],
                "properties": {
                  "front": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rear": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "byLocation": {
          "type": "object",
          "description": "Armor points per vehicle location",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byArc": {
          "type": "object",
          "description": "Armor points per aerospace arc",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "typeByLocation": {
          "type": "object",
          "description": "Patchwork armor types per installed vehicle location",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "barRatingByLocation": {
          "type": "object",
          "description": "Support patchwork BAR per installed vehicle location",
          "additionalProperties": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          }
        },
        "typeByArc": {
          "type": "object",
          "description": "Explicit BLK armor type codes per normalized source arc; includes sentinel -1. Distinct from armor points in byArc.",
          "additionalProperties": {
            "type": "integer",
            "minimum": -1
          }
        },
        "perTrooper": {
          "type": "integer",
          "minimum": 0,
          "description": "Battle armor points per trooper"
        }
      },
      "anyOf": [
        {
          "type": "object",
          "required": ["allocation"],
          "properties": {
            "allocation": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "object",
                    "required": ["front", "rear"],
                    "properties": {
                      "front": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "rear": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["byLocation"],
          "properties": {
            "byLocation": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["byArc"],
          "properties": {
            "byArc": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["perTrooper"],
          "properties": {
            "perTrooper": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "heatSinks": {
      "type": "object",
      "required": ["type", "count"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["SINGLE", "DOUBLE", "DOUBLE_CLAN", "COMPACT", "LASER"],
          "description": "Heat sink type"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of heat sinks"
        }
      },
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "required": [],
      "properties": {
        "walk": {
          "type": "integer",
          "minimum": 0,
          "description": "Walking MP"
        },
        "jump": {
          "type": "integer",
          "minimum": 0,
          "description": "Jumping MP"
        },
        "jumpJetType": {
          "type": "string",
          "enum": ["STANDARD", "IMPROVED", "MECHANICAL", "UMU"],
          "description": "Jump jet type"
        },
        "enhancements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Movement enhancements (MASC, Supercharger, etc.)"
        }
      },
      "additionalProperties": true
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "location"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Equipment ID reference"
          },
          "isAmmo": {
            "type": "boolean",
            "description": "Optional mounted ammunition category evidence"
          },
          "name": {
            "type": "string",
            "description": "Source display name for the mounted equipment"
          },
          "location": {
            "type": "string",
            "description": "Mounting location"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Specific slot indices"
          },
          "unitLocation": { "type": "string" },
          "isDWPMounted": { "type": "boolean" },
          "isSquadSupportWeapon": { "type": "boolean" },
          "isAPMMounted": { "type": "boolean" },
          "shots": { "type": "integer", "minimum": 0 },
          "size": { "type": "number", "minimum": 0 },
          "isRearMounted": {
            "type": "boolean",
            "default": false,
            "description": "Whether weapon is rear-facing"
          },
          "linkedAmmo": {
            "type": "string",
            "description": "Linked ammunition ID"
          },
          "isRemovable": {
            "type": "boolean",
            "description": "Whether the mounted item can be removed in the customizer"
          },
          "isOmniPodMounted": {
            "type": "boolean",
            "description": "Whether the mounted item belongs to an OmniMech pod"
          }
        },
        "additionalProperties": false
      },
      "description": "Mounted equipment list"
    },
    "criticalSlots": {
      "type": "object",
      "description": "Critical slot assignments per location",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "quirks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Unit quirks"
    },
    "weaponQuirks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      },
      "description": "Weapon quirks keyed by native LOCATION:SLOT:WEAPON_NAME; legacy name keys remain readable"
    },
    "fluff": {
      "type": "object",
      "properties": {
        "overview": {
          "type": "string"
        },
        "capabilities": {
          "type": "string"
        },
        "history": {
          "type": "string"
        },
        "deployment": {
          "type": "string"
        },
        "variants": {
          "type": "string"
        },
        "notableUnits": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "primaryFactory": {
          "type": "string"
        },
        "systemManufacturer": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "Fluff/flavor text"
    },
    "isOmni": { "type": "boolean" },
    "componentTechBases": {
      "type": "object",
      "description": "BattleMech Mixed Tech per-component tech base selections",
      "properties": {
        "chassis": { "$ref": "#/$defs/componentTechBase" },
        "gyro": { "$ref": "#/$defs/componentTechBase" },
        "engine": { "$ref": "#/$defs/componentTechBase" },
        "heatsink": { "$ref": "#/$defs/componentTechBase" },
        "targeting": { "$ref": "#/$defs/componentTechBase" },
        "myomer": { "$ref": "#/$defs/componentTechBase" },
        "movement": { "$ref": "#/$defs/componentTechBase" },
        "armor": { "$ref": "#/$defs/componentTechBase" }
      },
      "additionalProperties": false
    },
    "crewSeats": {
      "type": "array",
      "description": "BattleMech Tripod/QuadVee crew seats the user assigned; unassigned seats are absent",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "slotIndex": { "type": "integer", "minimum": 0, "maximum": 2 },
          "name": { "type": "string", "minLength": 1 },
          "gunnery": { "type": "integer", "minimum": 0, "maximum": 8 },
          "piloting": { "type": "integer", "minimum": 0, "maximum": 8 }
        },
        "required": ["slotIndex", "name", "gunnery", "piloting"],
        "additionalProperties": false
      }
    },
    "omniPodHeatSinks": { "type": "integer", "minimum": 0 },
    "baseChassisTurretWeight": { "type": "number", "minimum": 0 },
    "baseChassisTurret2Weight": { "type": "number", "minimum": 0 },
    "baseChassisSponsonPintleWeight": { "type": "number", "minimum": 0 },
    "baseChassisFireConWeight": { "type": "number", "minimum": 0 },
    "transporters": { "type": "array", "items": { "type": "string" } },
    "fuel": {
      "type": "number",
      "minimum": 0,
      "description": "Source fuel quantity; support vehicles use tons, aerospace uses points."
    },
    "fuelType": { "type": "string", "minLength": 1 },
    "isTrailer": { "type": "boolean" },
    "clanEngine": { "type": "boolean" },
    "structuralTechRating": { "type": "integer", "minimum": 0, "maximum": 5 },
    "engineTechRating": { "type": "integer", "minimum": 0, "maximum": 5 },
    "armorTechRating": { "type": "integer", "minimum": 0, "maximum": 5 },
    "internalType": { "type": "integer", "minimum": -1 },
    "sourceDefinition": {
      "type": "object",
      "description": "Originating source definition, independent of editor or campaign instance identity",
      "required": ["source", "id"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "enum": ["canonical", "custom"] },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "mulId": {
      "anyOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^[0-9-]+$" }
      ],
      "description": "Master Unit List identifier; legacy integer or lossless editor text"
    },
    "role": {
      "type": "string",
      "description": "Combat role"
    },
    "source": {
      "type": "string",
      "description": "Source book/publication"
    }
  },
  "additionalProperties": true,
  "anyOf": [
    {
      "properties": {
        "unitType": {
          "allOf": [
            {
              "not": {
                "$ref": "#/$defs/capitalUnitType"
              }
            },
            {
              "not": {
                "$ref": "#/$defs/battleArmorUnitType"
              }
            },
            {
              "not": {
                "$ref": "#/$defs/infantryUnitType"
              }
            },
            {
              "not": {
                "$ref": "#/$defs/protoMechUnitType"
              }
            }
          ]
        },
        "armor": {
          "type": "object",
          "properties": {
            "type": { "$ref": "#/$defs/standardArmorType" },
            "perTrooper": false,
            "sourceTechLevel": false
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unitLocation": false,
              "isDWPMounted": false,
              "isSquadSupportWeapon": false,
              "isAPMMounted": false,
              "shots": false,
              "size": false
            }
          }
        },
        "tonnage": { "type": "number", "maximum": 250 }
      }
    },
    {
      "required": ["unitType"],
      "properties": {
        "unitType": { "enum": ["Support Vehicle", "SupportVehicle"] },
        "armor": {
          "type": "object",
          "properties": {
            "type": { "$ref": "#/$defs/standardArmorType" },
            "perTrooper": false,
            "sourceTechLevel": false
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unitLocation": false,
              "isDWPMounted": false,
              "isSquadSupportWeapon": false,
              "isAPMMounted": false,
              "shots": false,
              "size": false
            }
          }
        },
        "tonnage": { "type": "number", "maximum": 600 }
      }
    },
    {
      "required": ["unitType"],
      "properties": {
        "unitType": { "$ref": "#/$defs/capitalUnitType" },
        "armor": {
          "type": "object",
          "properties": { "perTrooper": false, "sourceTechLevel": false }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unitLocation": false,
              "isDWPMounted": false,
              "isSquadSupportWeapon": false,
              "isAPMMounted": false,
              "shots": false,
              "size": false
            }
          }
        },
        "tonnage": { "type": "number", "maximum": 2500000 },
        "otherCrew": { "type": "integer", "minimum": 0 },
        "driveCoreType": { "type": "integer", "minimum": 0, "maximum": 4 },
        "jumpRange": { "type": "integer", "minimum": 0 },
        "hasSail": { "type": "boolean" },
        "hasLFBattery": { "type": "boolean" },
        "hasHPG": { "type": "boolean" },
        "gravDecks": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "dockingCollars": { "type": "integer", "minimum": 0 },
        "isModular": { "type": "boolean" }
      }
    },
    {
      "required": ["unitType"],
      "properties": {
        "unitType": { "$ref": "#/$defs/battleArmorUnitType" },
        "tonnage": { "type": "number", "maximum": 250 },
        "weightClass": { "type": "string" },
        "chassisType": { "type": "string", "enum": ["BIPED", "QUAD"] },
        "motionType": { "type": "string" },
        "squadSize": { "type": "integer", "minimum": 1 },
        "armorPerTrooper": { "type": "integer", "minimum": 0 },
        "manipulators": {
          "type": "object",
          "properties": {
            "rightArm": { "type": ["string", "null"] },
            "leftArm": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "hasAntiPersonnelMount": { "type": "boolean" },
        "hasModularWeaponMount": { "type": "boolean" },
        "clanChassis": { "type": "boolean" },
        "isExoskeleton": { "type": "boolean" },
        "clanExoWithoutHarJel": { "type": "boolean" },
        "turretSize": { "type": "integer", "minimum": 0 },
        "hasModularTurret": { "type": "boolean" },
        "movement": {
          "type": "object",
          "properties": {
            "groundMP": { "type": "integer", "minimum": 0 },
            "jumpMP": { "type": "integer", "minimum": 0 },
            "umuMP": { "type": "integer", "minimum": 0 },
            "vtolMP": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    {
      "required": ["unitType"],
      "properties": {
        "unitType": { "$ref": "#/$defs/infantryUnitType" },
        "tonnage": { "type": "number", "maximum": 250 },
        "armor": {
          "type": "object",
          "properties": {
            "type": { "$ref": "#/$defs/standardArmorType" },
            "perTrooper": false,
            "sourceTechLevel": false
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unitLocation": false,
              "isDWPMounted": false,
              "isSquadSupportWeapon": false,
              "isAPMMounted": false,
              "shots": false,
              "size": false
            }
          }
        },
        "motiveType": { "type": "string", "minLength": 1 },
        "motionType": { "type": "string", "minLength": 1 },
        "beastMount": { "type": "string", "minLength": 1 },
        "platoon": {
          "type": "object",
          "required": ["squadSize", "squadCount", "totalTroopers"],
          "properties": {
            "squadSize": { "type": "integer", "minimum": 1 },
            "squadCount": { "type": "integer", "minimum": 1 },
            "totalTroopers": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "primaryWeapon": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "secondaryWeapon": {
          "type": "object",
          "required": ["id", "name", "count"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "customArmorDamageDivisor": { "type": "number", "exclusiveMinimum": 0 },
        "damageDivisor": { "type": "number", "exclusiveMinimum": 0 },
        "armorKit": { "type": ["string", "null"] },
        "armorFlags": { "type": "array", "items": { "type": "string" } },
        "effectiveArmorFlags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "specializations": { "type": "integer", "minimum": 0, "maximum": 8191 },
        "augmentations": { "type": "array", "items": { "type": "string" } },
        "prostheticEnhancements": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "prostheticEnhancementCounts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "srmMunition": { "type": "string" },
        "disposableWeapon": { "type": "string", "minLength": 1 },
        "customArmorName": { "type": "string", "minLength": 1 }
      }
    },
    {
      "required": ["unitType"],
      "properties": {
        "unitType": { "$ref": "#/$defs/protoMechUnitType" },
        "armor": {
          "type": "object",
          "properties": {
            "type": { "$ref": "#/$defs/standardArmorType" },
            "perTrooper": false
          }
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unitLocation": false,
              "isDWPMounted": false,
              "isSquadSupportWeapon": false,
              "isAPMMounted": false,
              "shots": false,
              "size": false
            }
          }
        },
        "tonnage": { "type": "number", "maximum": 250 }
      }
    }
