      "reason": "Declared packaging exception: adds Windows and macOS jobs."
    },
    {
      "id": "ci",
      "paths": [".github/workflows/pr-checks.yml"],
      "typical": false,
      "reason": "CI/global configuration change turns on every gate including desktop packaging."
    },
    {
      "id": "budgets",
      "paths": ["config/ci/budgets.json"],
      "typical": false,
      "reason": "Budget-change PR: approval workflow and its trusted event jobs must be included when adopted; explicit exceptional profile."
    },
    {
      "id": "bootstrap",
      "paths": ["config/ci/budgets.json", ".github/workflows/pr-checks.yml"],
      "typical": false,
      "reason": "Explicit initial budget and CI wiring profile: all packaging legs plus trusted budget approval are counted."
    },
    {
      "id": "dependency",
      "paths": ["package-lock.json"],
      "typical": false,
      "reason": "Dependency/global change: all packaging legs plus trusted dependency-label approval are counted."
    }
  ],
