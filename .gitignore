# Keep the provenance command guide available to staging and commit hooks.
!/docs/data/
/docs/data/*
!/docs/data/portable-source-provenance.md
!/docs/data/examples/

# Keep the source unit schema available to normal staging and commit checks.
!/public/data/
/public/data/*
!/public/data/equipment/
/public/data/equipment/*
# Only the reviewed generator's outputs (CAT-Q2) are allowlisted; the rest of
# official/ stays ignored, so new hand-written catalog files can't be staged.
!/public/data/equipment/official/
/public/data/equipment/official/*
!/public/data/equipment/official/ammunition/
!/public/data/equipment/official/miscellaneous/
!/public/data/equipment/official/weapons/
/public/data/equipment/official/ammunition/*
/public/data/equipment/official/miscellaneous/*
/public/data/equipment/official/weapons/*
!/public/data/equipment/official/*/java-registry.json
# Let hooks traverse electronics to restage tracked catalogs; new files stay ignored.
!/public/data/equipment/official/electronics/
/public/data/equipment/official/electronics/*
!/public/data/equipment/registry-routing.json
!/public/data/equipment/_schema/
/public/data/equipment/_schema/*
!/public/data/equipment/_schema/unit-schema.json

# Converted vehicle, aerospace and capital-ship catalogs stage without `git add -f`.
!/public/data/units/
/public/data/units/*
!/public/data/units/vehicles/
!/public/data/units/aerospace/
!/public/data/units/capital/

